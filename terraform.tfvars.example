# ==============================================================================
# AWS EKS Production - Example Variable Definitions
# ==============================================================================
# Copy this file to `terraform.tfvars` and customize your values.
# NEVER commit your production terraform.tfvars containing sensitive secrets.

aws_region   = "ap-south-1"
environment  = "production"
project_name = "eks-production"

# --- VPC & Subnets ---
vpc_cidr              = "10.0.0.0/16"
availability_zones    = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs  = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]

# Cost vs HA Toggle:
# Set to true for 3 NAT Gateways (1 per AZ, recommended for strict production HA).
# Set to false for 1 shared NAT Gateway (saves ~$65/month on AWS NAT charges).
enable_ha_nat_gateway = false

# --- EKS Cluster ---
cluster_name    = "eks-production-cluster"
cluster_version = "1.36"

# Restrict Kubernetes API endpoint access (Replace with your office/VPN CIDR in strict enterprise setups)
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# --- Node Groups ---
node_groups = {
  general = {
    instance_types = ["t3.medium"]
    capacity_type  = "ON_DEMAND"
    desired_size   = 2
    min_size       = 1
    max_size       = 4
    disk_size      = 30
    labels = {
      role = "general-workloads"
    }
  }
}
